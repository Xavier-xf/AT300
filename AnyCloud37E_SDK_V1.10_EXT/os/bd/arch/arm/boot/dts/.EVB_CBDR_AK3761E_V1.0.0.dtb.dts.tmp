&pm_standby {
    pinctrl-names = "default";
    pinctrl-0 = <&pm_wakeup_pins>;





    wakeup-mode = <0x1 0x2 0x3 0x4>;

    wakeup-gpio = <&gpio 31 1>;





    wakeup-gpio-edge = <0x1>;





    wakeup-ain0-edge = <0x0>;

    status = "okay";
};

&uart0 {
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&uart0_pins>;
    pinctrl-1 = <&uart0_pins_sleep>;
    status = "okay";
};

&watchdog {

    def_heartbeat = <10>;
    status = "okay";
};

&rtc {




    osc-select = <1>;
    adjust-time = <1000>;
    adjust-based-on-timer;
    status = "okay";
};

&i2c2 {
    pinctrl-names = "default","sleep";
    pinctrl-0 = <&i2c2_pins>;
    pinctrl-1 = <&i2c2_sleep_pins>;

    clock-frequency = <400000>;
    sda-delay = <100>;
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    touch-screen@40 {
        compatible = "anyka,ak37e-i2c-touchscreen-gslX680";
        reg = <0x40>;


        pinctrl-names = "default";
        pinctrl-0 = <&gslX680_pins>;
        irq-gpio = <&gpio 45 1>;
        reset-gpio = <&gpio 44 1>;
        TP_MAX_X = <1280>;
        TP_MAX_Y = <800>;
        status = "disable";
      };

      touch-screen@48 {
        compatible = "anyka,ak37e-i2c-touchscreen-icn85xx";
        reg = <0x48>;


        pinctrl-names = "default";
        pinctrl-0 = <&icn85xx_pins>;
        irq-gpio = <&gpio 69 1>;
        reset-gpio = <&gpio 68 1>;
        TP_MAX_X = <1024>;
        TP_MAX_Y = <600>;
        status = "okay";
      };
};


