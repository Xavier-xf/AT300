    status = "okay";

    addet0 {
        unpress_min = <0>;
        unpress_max = <3200>;
        adc_index = <1>;
        adc_channel = <0>;

        key1 {
            linux,code = <102>;
            min = <0>;
            max = <50>;
        };

        key2 {
            linux,code = <103>;
            min = <478>;
            max = <708>;
        };

        key3 {
            linux,code = <108>;
            min = <1020>;
            max = <1320>;
        };

        key4 {
            linux,code = <105>;
            min = <1510>;
            max = <1810>;
        };

        key5 {
            linux,code = <106>;
            min = <1980>;
            max = <2280>;
        };

